# Copy this file to .env.local and fill in your Supabase project credentials
# Get them from: https://supabase.com/dashboard/project/_/settings/api-keys
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...

# ─── Coaching AI (layer C fallback) ─────────────────────────────
# Google Gemini free tier — 1500 requests/day, 1M tokens/day.
# Layers A (calculators) + B (knowledge base) answer 80-90% of
# questions without ever touching this key. Gemini kicks in only
# when neither layer matches.
#
# Get a free key: https://aistudio.google.com/apikey
# Leave empty to disable — the guide falls back to the built-in
# nav-fallback answer for un-matched questions.
VITE_GEMINI_KEY=
